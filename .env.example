# GitHub Gist Id
GIST_ID=""
# GitHub Gist Token
GIST_TOKEN=""

# Admin Username
ACCESS_USERNAME="admin"
# Admin Password
ACCESS_PASSWORD="123456"
# 2FA Secret
ACCESS_2FA_SECRET="xxxx"

# JWT Secret
JWT_SECRET=""
# JWT Token Expiration Time
JWT_EXPIRES_IN="7d"

# API Secret Key
API_SECRET=""

# DOH API Key
DOH_API_KEY=""

# MCP: `/mcp` is server-gated (guests redirect to login, no skeleton). `GET /api/mcp/headers` returns install headers only when the session is valid; never embedded in static HTML.
# Hosts (`/custom-dns`) uses the same server session gate before the client editor loads.
# `/api/mcp` accepts the session cookie or `x-api-key` matching DNS_MCP_HEADERS (Cursor sends the key from copied JSON).
# Example: DNS_MCP_HEADERS='{"x-api-key":"your-secret"}'
# DNS_MCP_HEADERS=""

# Optional: max wall time per MCP tool execution (JSON-RPC tools/call and legacy POST). Clamped 3000–24000 ms; default 20000.
# MCP_TOOL_CALL_TIMEOUT_MS="20000"

# Signet third-party login (unset to hide; auth center origin is derived from this SDK URL)
# Whitelist your callback origin in Signet ALLOWED_REDIRECT_URLS
SIGNET_SDK_URL="https://vercel-2fa.vercel.app/sdk/signet-client.mjs"
